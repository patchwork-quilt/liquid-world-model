+class IntentionPolicy:
+    """Round 2, Fix 2 — the morning's questions as intentions.
+
+    A wrapper around the shipped ExplorerPolicy (itself reached
+    through round 1's ProbePolicy for the uncharted questions that
+    stay foot-probes). The morning allocator (``tiers.allocate_probes``,
+    mode ``"walk3"``) hands the day a list of *intentions* — named,
+    expiring policy modifiers derived from the bought questions —
+    and this policy lets them bias its own choices, in this order:
+
+    1. **ensure-item** fires only when it matters: the agent does
+       not hold the item, and either it stands at an exit the chart
+       says is gated by that item, or the believed goal route from
+       here crosses such an exit. Then the policy routes to the
+       item's charted home and fetches it *before* the route
+       proceeds — a route-level change, issued by no special case:
+       the gating and the home both come from the chart's records.
+    2. **verify** — the policy treats the named place as a subgoal
+       woven into its own day: it routes there over believed ways
+       when no readiness intention is acting. Arrival fulfils it —
+       the chart records the place seen today, contents and all.
+    3. **probes** — round 1's ProbePolicy, for the bought uncharted
+       questions only (traversing an exit is an act, not a bias).
+    4. the wrapped shipped policy, unmodified.
+
+    Intentions expire: fulfilled when their condition is met,
+    dropped when unreachable on believed ways, and replaced wholesale
+    each morning (``set_day``). Directed movement (intention steps +
+    probe steps) shares one daily budget — MAX_DIRECTED_STEPS, the
+    same 200 round 1 capped probes at — so a morning's agenda can
+    never eat the whole day. Routing never passes through an exit
+    the chart says is gated by an item the agent does not hold: a
+    door you cannot open is not a way. Every firing, fulfilment,
+    and drop is written to ``intention_log`` — the receipt.
+    """
+
+    MAX_DIRECTED_STEPS = 200
+
+    def __init__(self, base: Any = None) -> None:
+        self.base = base if base is not None else ExplorerPolicy()
+        self.probes = ProbePolicy(self.base)
+        self.intentions: List[Dict[str, Any]] = []
+        self.intention_steps = 0
+        self.intention_log: List[Dict[str, Any]] = []
+
+    # -- morning -----------------------------------------------------
+    def set_day(self, targets: List[Dict[str, Any]],
+                intentions: List[Dict[str, Any]]) -> None:
+        self.probes.set_targets(targets)
+        self.intentions = intentions
+        self.intention_steps = 0
+
+    @property
+    def probe_steps(self) -> int:
+        return self.probes.probe_steps
+
+    def _directed(self) -> int:
+        return self.intention_steps + self.probes.probe_steps
+
+    def _log(self, event: str, intention: Dict[str, Any],
+             place: str) -> None:
+        self.intention_log.append({
+            "event": event, "name": intention["name"],
+            "kind": intention["kind"], "issued_day": intention["day"],
+            "at_place": place,
+            "directed_steps": intention.get("directed_steps", 0),
+        })
+
+    # -- routing -------------------------------------------------------
+    def _route_graph(self, chart: Any,
+                     holding: List[str]) -> Dict[str, Dict[str, str]]:
+        """Believed ways, as ProbePolicy routes them — minus any
+        exit the chart says is gated by an item not held."""
+        graph = {pid: dict(dirs) for pid, dirs in
+                 chart.transit_graph(holding).items()}
+        for pid in chart.places:
+            for direction, belief in chart.known_exits(pid).items():
+                dest = belief.get("to")
+                if dest is None:
+                    continue
+                if direction in graph.get(pid, {}):
+                    continue
+                status = chart.edge_status(pid, direction)
+                last = status["last"]
+                if (last and last["outcome"] == "blocked-locked"
+                        and not set(holding) - set(last.get("holding", []))):
+                    continue
+                graph.setdefault(pid, {})[direction] = dest
+        for pid in list(graph):
+            for direction in list(graph[pid]):
+                item = exit_gating_item(chart, pid, direction)
+                if item and item not in holding:
+                    del graph[pid][direction]
+        return graph
+
+    def _first_step(self, chart: Any, start: str, goal: str,
+                    holding: List[str]) -> Optional[str]:
+        if start == goal:
+            return None
+        graph = self._route_graph(chart, holding)
+        seen = {start}
+        queue = deque([(start, None)])
+        while queue:
+            node, first = queue.popleft()
+            for direction in sorted(graph.get(node, {})):
+                nxt = graph[node][direction]
+                if nxt in seen:
+                    continue
+                if nxt == goal:
+                    return direction if first is None else first
+                seen.add(nxt)
+                queue.append((nxt, direction if first is None else first))
+        return None
+
+    def _goal_path_edges(self, chart: Any, start: str,
+                         holding: List[str]) -> Optional[List[Any]]:
+        goal = chart.goal_place()
+        if goal is None or goal == start:
+            return None
+        graph = chart.transit_graph(holding)
+        seen = {start}
+        queue = deque([(start, [])])
+        while queue:
+            node, edges = queue.popleft()
+            if node == goal:
+                return edges
+            for direction in sorted(graph.get(node, {})):
+                nxt = graph[node][direction]
+                if nxt not in seen:
+                    seen.add(nxt)
+                    queue.append((nxt, edges + [(node, direction)]))
+        return None
+
+    def _ensure_triggered(self, chart: Any, obs: Observation,
+                          intention: Dict[str, Any]) -> bool:
+        """Fires when it matters: standing at a gated exit for the
+        item, or the believed goal route from here crosses one."""
+        gated = {tuple(e) for e in intention["gated_edges"]}
+        place = obs["place"]
+        if any(p == place for (p, _d) in gated):
+            return True
+        edges = self._goal_path_edges(chart, place,
+                                      list(obs.get("holding", [])))
+        if edges is None:
+            return False
+        return any(tuple(e) in gated for e in edges)
+
+    # -- the day -------------------------------------------------------
+    def decide(self, chart: Any, obs: Observation,
+               rng: random.Random) -> Optional[str]:
+        place = obs["place"]
+        holding = list(obs.get("holding", []))
+
+        # Fulfilment is checked against the chart's own record:
+        # a verify is done when the place stands seen today; an
+        # ensure-item is done when the item is in hand.
+        for it in self.intentions:
+            if it["status"] != "active":
+                continue
+            if it["kind"] == "verify":
+                p = chart.places.get(it["place"])
+                if p is not None and p.last_seen_day >= it["day"]:
+                    it["status"] = "fulfilled"
+                    self._log("fulfilled", it, place)
+            elif it["kind"] == "ensure-item" and it["item"] in holding:
+                it["status"] = "fulfilled"
+                self._log("fulfilled", it, place)
+
+        # 1. readiness: fetch a gating item before the route needs it
+        for it in self.intentions:
+            if it["kind"] != "ensure-item" or it["status"] != "active":
+                continue
+            if it["item"] in holding or it["home"] is None:
+                continue
+            if self._directed() >= self.MAX_DIRECTED_STEPS:
+                break
+            if not self._ensure_triggered(chart, obs, it):
+                continue
+            if place == it["home"]:
+                it["status"] = "dropped"
+                self._log("dropped-at-home-empty-handed", it, place)
+                continue
+            step = self._first_step(chart, place, it["home"], holding)
+            if step is None:
+                it["status"] = "dropped"
+                self._log("dropped-unreachable", it, place)
+                continue
+            self.intention_steps += 1
+            it["directed_steps"] += 1
+            self._log("fetch-step", it, place)
+            return step
+
+        # 2. verify: the first unfulfilled place, in issue order
+        for it in self.intentions:
+            if it["kind"] != "verify" or it["status"] != "active":
+                continue
+            if self._directed() >= self.MAX_DIRECTED_STEPS:
+                break
+            if place == it["place"]:
+                continue
+            step = self._first_step(chart, place, it["place"], holding)
+            if step is None:
+                it["status"] = "dropped"
+                self._log("dropped-unreachable", it, place)
+                continue
+            self.intention_steps += 1
+            it["directed_steps"] += 1
+            self._log("verify-step", it, place)
+            return step
+
+        # 3. probes for the bought uncharted questions (round 1's
+        # machinery), inside the same directed budget
+        if self.probes.targets and \
+                self._directed() < self.MAX_DIRECTED_STEPS:
+            return self.probes.decide(chart, obs, rng)
+
+        # 4. the shipped policy, unmodified
+        return self.base.decide(chart, obs, rng)
