+def _staleness_floor(chart: Any, pid: str, day: int) -> float:
+    """Round 2, Fix 1 — the fog summand of a place's own ignorance,
+    lifted out of the activation product. Effective confidence is
+    charted confidence rotted by fog; the difference is confidence
+    the model held and has since lost to time. It is computed from
+    the framework's own numbers only (the charted confidence and
+    FOG_DECAY inside effective_confidence) — no new constant — and
+    it is zero for a fresh or never-charted place."""
+    place = chart.places.get(pid)
+    if place is None or not place.observed:
+        return 0.0
+    return round(max(0.0, place.confidence
+                     - chart.effective_confidence(pid, day)), 4)
+
+
+def exit_gating_item(chart: Any, place_id: str,
+                     direction: str) -> Optional[str]:
+    """The item this exit is gated by, per the chart's OWN records
+    only (never the engine): the belief's charted ``opens_with`` if
+    there is one; else the item a recorded traversal's event
+    testifies unlocked the way while the agent held it — the
+    attempt log is testimony the model itself recorded, event text
+    and holdings included. None if the chart knows no gate here."""
+    place = chart.places.get(place_id)
+    if place is None:
+        return None
+    belief = place.belief_exits.get(direction)
+    if belief is None:
+        return None
+    if belief.get("opens_with"):
+        return belief["opens_with"]
+    edge = chart.edges.get((place_id, direction))
+    if not edge:
+        return None
+    for attempt in edge["attempts"]:
+        if attempt["outcome"] != "traversed":
+            continue
+        event = (attempt.get("event") or "").lower()
+        if "unlock" not in event:
+            continue
+        for item in attempt.get("holding", []):
+            if item.lower() in event:
+                return item
+    return None
+
+
+def gated_items(chart: Any, place_id: str) -> List[Dict[str, Any]]:
+    """Every item-gated exit of a place, per the chart's records."""
+    place = chart.places.get(place_id)
+    if place is None:
+        return []
+    out: List[Dict[str, Any]] = []
+    for direction in sorted(place.belief_exits):
+        item = exit_gating_item(chart, place_id, direction)
+        if item:
+            out.append({"direction": direction, "item": item})
+    return out
+
+
+def all_gated_edges(chart: Any, item: str) -> List[List[str]]:
+    """Every [place, direction] on the chart gated by ``item``."""
+    out: List[List[str]] = []
+    for pid in sorted(chart.places):
+        for g in gated_items(chart, pid):
+            if g["item"] == item:
+                out.append([pid, g["direction"]])
+    return out
+
+
+def item_home(chart: Any, item: str) -> Optional[str]:
+    """Where the model's own log says it acquired ``item``: the
+    destination of the recorded traversal whose event reports the
+    taking. None if the log never says — the item's home is then
+    not on the chart, whatever the world holds."""
+    for (pid, direction), edge in sorted(chart.edges.items()):
+        for attempt in edge["attempts"]:
+            if attempt["outcome"] != "traversed":
+                continue
+            event = (attempt.get("event") or "").lower()
+            if "take" in event and item.lower() in event \
+                    and attempt.get("to"):
+                return attempt["to"]
+    return None
+
