+def _derive_intentions(chart: Any, day: int, bought: List[Dict[str, Any]],
+                       start: str) -> List[Dict[str, Any]]:
+    """The morning's bought questions, translated into intentions
+    (round 2, Fix 2 — see policy.IntentionPolicy for how they act).
+
+    Two readiness sources, both from the chart's own records:
+    (a) a bought question whose place has an item-gated exit, and
+    (b) if the goal place's question was bought, every item-gated
+    edge on the believed start->goal route — buying the goal buys
+    its route's readiness. Every other bought conflict/fog/tie
+    question becomes a verify intention for its place. Intentions
+    are issued in question rank order, readiness before verify for
+    the same question; duplicates collapse to the first issue."""
+    intentions: List[Dict[str, Any]] = []
+    seen_items: set = set()
+    seen_verify: set = set()
+
+    def ensure(item: str, gated_place: str, gated_direction: str,
+               source: Dict[str, Any]) -> None:
+        if item in seen_items:
+            return
+        seen_items.add(item)
+        intentions.append({
+            "name": f"ensure-item:{item}", "kind": "ensure-item",
+            "item": item, "home": item_home(chart, item),
+            "gated_edges": all_gated_edges(chart, item),
+            "gated_place": gated_place, "gated_direction": gated_direction,
+            "day": day, "status": "active", "directed_steps": 0,
+            "source_question": {"place": source["place"],
+                                "kind": source["kind"],
+                                "rank": source["rank"]},
+        })
+
+    def verify(q: Dict[str, Any]) -> None:
+        pid = q["place"]
+        if pid in seen_verify:
+            return
+        seen_verify.add(pid)
+        intentions.append({
+            "name": f"verify:{pid}", "kind": "verify", "place": pid,
+            "day": day, "status": "active", "directed_steps": 0,
+            "source_question": {"place": pid, "kind": q["kind"],
+                                "rank": q["rank"]},
+        })
+
+    goal = chart.goal_place()
+    for q in bought:
+        for g in gated_items(chart, q["place"]):
+            ensure(g["item"], q["place"], g["direction"], q)
+        if q["kind"] in ("conflict", "fog", "tie"):
+            verify(q)
+    if goal is not None and any(q["place"] == goal for q in bought):
+        # (b) the believed route to a bought goal, edge by edge
+        graph = chart.transit_graph([])
+        seen = {start}
+        queue = deque([(start, [])])
+        path: Optional[List[Any]] = None
+        while queue:
+            node, edges = queue.popleft()
+            if node == goal:
+                path = edges
+                break
+            for direction in sorted(graph.get(node, {})):
+                nxt = graph[node][direction]
+                if nxt not in seen:
+                    seen.add(nxt)
+                    queue.append((nxt, edges + [(node, direction)]))
+        if path:
+            goal_q = next(q for q in bought if q["place"] == goal)
+            for (pid, direction) in path:
+                item = exit_gating_item(chart, pid, direction)
+                if item:
+                    ensure(item, pid, direction, goal_q)
+    return intentions
