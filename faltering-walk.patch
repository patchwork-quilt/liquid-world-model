+
+class ProbePolicy:
+    """A wrapper that spends the day's bought questions first.
+
+    The morning allocator (``tiers.allocate_probes``) turns ranked
+    questions into probe targets: a place to re-observe, or a place
+    plus an exit to traverse. This policy routes to each target in
+    order — over the graph the chart believes walkable — and then
+    hands the day back to the wrapped policy, unmodified. Routing
+    that cannot reach a target drops it rather than wandering.
+    Probe-directed steps are capped so a bought question can never
+    eat the whole day; the cap is part of the instrument, stated
+    here: MAX_PROBE_STEPS directed moves per day.
+    """
+
+    MAX_PROBE_STEPS = 200
+
+    def __init__(self, base: Any = None) -> None:
+        self.base = base if base is not None else ExplorerPolicy()
+        self.targets: List[Dict[str, Any]] = []
+        self.probe_steps = 0
+
+    def set_targets(self, targets: List[Dict[str, Any]]) -> None:
+        self.targets = [dict(t) for t in targets]
+        self.probe_steps = 0
+
+    def _route_graph(self, chart: Any, holding: List[str]) -> Dict[str, Dict[str, str]]:
+        graph = {pid: dict(dirs) for pid, dirs in
+                 chart.transit_graph(holding).items()}
+        for pid in chart.places:
+            for direction, belief in chart.known_exits(pid).items():
+                dest = belief.get("to")
+                if dest is None:
+                    continue
+                if direction in graph.get(pid, {}):
+                    continue
+                status = chart.edge_status(pid, direction)
+                last = status["last"]
+                if (last and last["outcome"] == "blocked-locked"
+                        and not set(holding) - set(last.get("holding", []))):
+                    continue  # known to refuse us as we are; don't route in
+                graph.setdefault(pid, {})[direction] = dest
+        return graph
+
+    def _first_step(self, chart: Any, start: str, goal: str,
+                    holding: List[str]) -> Optional[str]:
+        graph = self._route_graph(chart, holding)
+        seen = {start}
+        queue = deque([(start, None)])
+        while queue:
+            node, first = queue.popleft()
+            if node == goal and first is not None:
+                return first
+            for direction in sorted(graph.get(node, {})):
+                nxt = graph[node][direction]
+                if nxt not in seen:
+                    seen.add(nxt)
+                    queue.append((nxt, direction if first is None else first))
+        return None
+
+    def decide(self, chart: Any, obs: Observation,
+               rng: random.Random) -> Optional[str]:
+        while self.targets and self.probe_steps < self.MAX_PROBE_STEPS:
+            target = self.targets[0]
+            place = obs["place"]
+            if place == target["place"]:
+                direction = target.get("direction")
+                self.targets.pop(0)
+                if direction:
+                    self.probe_steps += 1
+                    return direction
+                continue  # arrival is the observation; target served
+            step = self._first_step(chart, place, target["place"],
+                                    list(obs.get("holding", [])))
+            if step is None:
+                self.targets.pop(0)  # unreachable on believed ways; drop it
+                continue
+            self.probe_steps += 1
+            return step
+        return self.base.decide(chart, obs, rng)
